<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
      Orbit Desk design tokens: the shape, spacing, type and motion every style and view shares. Colors are theme tokens
      (Theme.Dark/Light.xaml, ThemeManager accents) and materials are Theme/Materials.cs. Change a value here, not in a view.
      Merged before Styles.xaml so styles can use StaticResource.
    -->

    <!-- Corner radii: chips, controls (buttons, boxes, segments), cards, the open panel. -->
    <CornerRadius x:Key="RadiusChip">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">26</CornerRadius>
    <sys:Double x:Key="RadiusControlValue">8</sys:Double>
    <sys:Double x:Key="RadiusCardValue">14</sys:Double>

    <!-- Spacing scale. -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">24</sys:Double>
    <Thickness x:Key="ControlPadding">12,6,12,6</Thickness>
    <Thickness x:Key="CardPadding">16,14,16,14</Thickness>

    <!-- Type ramp: captions and hints, body, emphasis, titles, page headers. -->
    <sys:Double x:Key="FontCaption">11</sys:Double>
    <sys:Double x:Key="FontBody">12</sys:Double>
    <sys:Double x:Key="FontEmphasis">13</sys:Double>
    <sys:Double x:Key="FontTitle">14</sys:Double>
    <sys:Double x:Key="FontHeader">20</sys:Double>

    <!-- Icon sizes. -->
    <sys:Double x:Key="IconSmall">12</sys:Double>
    <sys:Double x:Key="IconMedium">15</sys:Double>
    <sys:Double x:Key="IconLarge">20</sys:Double>

    <!-- Motion: hover and press feedback, small transitions, panels. Skipped entirely when Motion.Enabled is false. -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionNormal">0:0:0.18</Duration>
    <Duration x:Key="MotionSlow">0:0:0.24</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
</ResourceDictionary>
