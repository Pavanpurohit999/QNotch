<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Mocha (Orbit Desk default). Dark palette. Every key here must also exist in Theme.Light.xaml. Always reference with DynamicResource. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#11111B"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#181825"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#181825"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#313244"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#2EB4BEFE"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#4DB4BEFE"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#1ACDD6F4"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#29CDD6F4"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#38CDD6F4"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#CDD6F4"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6ADC8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7F849C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F38BA8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#A6E3A1"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FAB387"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59585B70"/>
</ResourceDictionary>
