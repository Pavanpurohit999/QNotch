<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Orbit Desk "island" dark palette: a pure black notch that merges with the screen edge, neutral greys for depth,
         monochrome chrome. Color comes from content and status only. Every key here must also exist in Theme.Light.xaml.
         Always reference with DynamicResource. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#0C0C0D"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#101011"/>
    <SolidColorBrush x:Key="CardBrush" Color="#141415"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#2BFFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6F6F75"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F2605A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F2A93B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#47FFFFFF"/>
</ResourceDictionary>
