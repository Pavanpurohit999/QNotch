<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Orbit Desk light palette: neutral paper greys, white cards, near-black text, monochrome chrome. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F6F7"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#EDEDEF"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F1F1F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#17000000"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#21000000"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#55555B"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#69696F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D63A33"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F8F57"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A65F00"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="IslandRimBrush" Color="#14000000"/>
</ResourceDictionary>
